# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODELS: optional comma-separated model chain, tried in order. Each
# free-tier model has its own quota, so the server falls through to the next on
# HTTP 429 (quota) / 404 (unavailable) / 503 (overloaded) / timeout. Defaults to:
#   gemini-flash-latest,gemini-flash-lite-latest,gemini-3.6-flash
# GEMINI_MODELS="gemini-flash-latest,gemini-flash-lite-latest"

# GEMINI_TIMEOUT_MS: per-model request timeout (default 45000). A model that
# hangs past this is aborted and the chain moves on.
# GEMINI_TIMEOUT_MS="45000"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Google OAuth 2.0 (Gmail sign-in, gmail.readonly scope) -----------------
# Create an OAuth client (type: Web application) in Google Cloud Console, add
# GOOGLE_REDIRECT_URI below as an authorised redirect URI, and add the gmail.readonly
# scope + your test users on the OAuth consent screen (Testing mode is fine).
GOOGLE_CLIENT_ID="MY_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="MY_GOOGLE_CLIENT_SECRET"
GOOGLE_REDIRECT_URI="http://localhost:3000/auth/callback"

# --- Threat intelligence ---------------------------------------------------
# AbuseIPDB: automatic IP-reputation check for every public relay-chain IP
# (~1000 checks/day free). VirusTotal: on-demand "Deep Scan" of URLs + attachment
# hashes (~4 req/min free) — VT_MIN_INTERVAL_MS paces the live calls.
ABUSEIPDB_API_KEY="MY_ABUSEIPDB_API_KEY"
VIRUSTOTAL_API_KEY="MY_VIRUSTOTAL_API_KEY"
# VT_MIN_INTERVAL_MS="16000"

# --- ML detection engine (optional third engine) --------------------------
# Local Python microservice in ml_service/ (FastAPI + a pretrained BERT phishing
# classifier). No API key. If it is not running the analysis silently falls back
# to the rule + Gemini 50/50 blend. Start it with:
#   cd ml_service && pip install -r requirements.txt && uvicorn main:app --port 8000
# ML_SERVICE_URL="http://localhost:8000"
# ML_TIMEOUT_MS="8000"
