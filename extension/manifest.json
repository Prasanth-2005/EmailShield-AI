{
  "manifest_version": 3,
  "name": "EmailShield AI — Gmail Quick Scan",
  "version": "0.1.0",
  "description": "Analyze the open Gmail message with your local EmailShield AI backend. Body & sender only — header forensics stays in the web app.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": ["http://localhost:3000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "EmailShield AI — Gmail Quick Scan"
  }
}
